  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
